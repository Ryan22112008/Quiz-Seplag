generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Quiz {
  id          String     @id
  title       String     @db.VarChar(100)
  description String?    @db.VarChar(300)
  category    String     @db.VarChar(80)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  ownerId     String?
  deletedAt   DateTime?
  owner       User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  questions   Question[]
  rooms       Room[]
  reports     GameReport[]
  @@index([ownerId])
  @@index([ownerId, deletedAt])
}

model User {
  id        String         @id @default(cuid())
  googleId  String?        @unique @db.VarChar(191)
  email     String         @unique @db.VarChar(191)
  name      String         @db.VarChar(191)
  avatarUrl String?        @db.VarChar(500)
  passwordHash String?     @db.VarChar(255)
  emailVerifiedAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  quizzes   Quiz[]
  sessions  AuthSession[]
  roomPlayers RoomPlayer[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
}

model EmailVerificationToken {
  id                  String   @id @db.Char(64)
  userId              String
  pendingPasswordHash String?  @db.VarChar(255)
  expiresAt           DateTime
  createdAt           DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @db.Char(64)
  userId    String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthSession {
  id        String   @id @db.Char(64)
  userId    String
  csrfToken String   @db.Char(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OAuthState {
  id          String   @id @db.Char(64)
  nonce       String   @db.VarChar(128)
  codeVerifier String  @db.VarChar(128)
  returnTo    String   @db.VarChar(500)
  expiresAt   DateTime

  @@index([expiresAt])
}

model Question {
  id              String   @id
  quizId          String
  question        String   @db.VarChar(300)
  imageUrl        String?  @db.VarChar(500)
  correctOptionId String
  timeLimit       Int
  revealTime      Int      @default(0)
  points          Int
  position        Int
  quiz            Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options         Option[]

  @@unique([quizId, position])
  @@index([quizId])
}

model Option {
  id         String   @id
  questionId String
  text       String   @db.VarChar(100)
  imageUrl   String?  @db.VarChar(500)
  position   Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
  @@index([questionId])
}

model Room {
  id        String       @id
  pin       String       @unique @db.Char(6)
  quizId    String
  status    RoomStatus
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  quiz      Quiz         @relation(fields: [quizId], references: [id], onDelete: Restrict)
  players   RoomPlayer[]
  reports   GameReport[]

  @@index([quizId])
}

model GameReport {
  id                String   @id @db.VarChar(128)
  quizId            String
  roomId            String
  roomPin           String   @db.Char(6)
  startedAt         DateTime
  finishedAt        DateTime
  durationSeconds   Int
  participantCount  Int
  questionCount     Int
  totalAnswers      Int
  correctAnswers    Int
  accuracyRate      Int
  details           Json
  deletedAt         DateTime?
  createdAt         DateTime @default(now())
  quiz              Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  room              Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([quizId, finishedAt])
  @@index([deletedAt, finishedAt])
}

enum RoomStatus {
  WAITING
  STARTING
  IN_PROGRESS
  FINISHED
}

model RoomPlayer {
  id           String   @id
  roomId       String
  userId       String?  @db.VarChar(191)
  email        String?  @db.VarChar(191)
  name         String   @db.VarChar(24)
  avatarCharacterId String @default("bear") @db.VarChar(24)
  avatarAccessoryId String @default("none") @db.VarChar(24)
  normalizedName String @db.VarChar(24)
  position     Int
  createdAt    DateTime @default(now())
  room         Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([roomId, normalizedName])
  @@index([roomId])
  @@index([userId])
}
