generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Quiz {
  id          String     @id
  title       String     @db.VarChar(100)
  description String?    @db.VarChar(300)
  category    String     @db.VarChar(80)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  questions   Question[]
  rooms       Room[]
}

model Question {
  id              String   @id
  quizId          String
  question        String   @db.VarChar(300)
  imageUrl        String?  @db.VarChar(500)
  correctOptionId String
  timeLimit       Int
  points          Int
  position        Int
  quiz            Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options         Option[]

  @@unique([quizId, position])
  @@index([quizId])
}

model Option {
  id         String   @id
  questionId String
  text       String   @db.VarChar(100)
  imageUrl   String?  @db.VarChar(500)
  position   Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
  @@index([questionId])
}

model Room {
  id        String       @id
  pin       String       @unique @db.Char(6)
  quizId    String
  status    RoomStatus
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  quiz      Quiz         @relation(fields: [quizId], references: [id], onDelete: Restrict)
  players   RoomPlayer[]

  @@index([quizId])
}

enum RoomStatus {
  WAITING
  STARTING
  IN_PROGRESS
  FINISHED
}

model RoomPlayer {
  id           String   @id
  roomId       String
  name         String   @db.VarChar(24)
  normalizedName String @db.VarChar(24)
  position     Int
  createdAt    DateTime @default(now())
  room         Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, normalizedName])
  @@index([roomId])
}
